//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define L4   4
#define L5   5
#define L6   6

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0 1>;
        };

        tab_comboL {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0 1>;
        };

        tab_comboR {
            bindings = <&kp TAB>;
            key-positions = <17 18>;
            layers = <0 1>;
        };

        game_layer_toggle {
            bindings = <&tog 2>;
            key-positions = <32 37>;
            layers = <0 3>;
        };

        bace_combo {
            bindings = <&brace_block>;
            key-positions = <4 5>;
            timeout-ms = <30>;
            layers = <0>;
        };

        bracket_combo {
            bindings = <&bracket_block>;
            key-positions = <14 15>;
            layers = <0>;
            timeout-ms = <30>;
        };

        parenth_block {
            bindings = <&parenth_block>;
            key-positions = <25 26>;
            timeout-ms = <30>;
            layers = <0>;
        };

        base_1 {
            bindings = <&kp NUMBER_1>;
            key-positions = <0 10>;
            layers = <0>;
        };

        base_2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <1 11>;
            layers = <0>;
        };

        base_3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <2 12>;
            layers = <0>;
        };

        base_4 {
            bindings = <&kp NUMBER_4>;
            key-positions = <3 13>;
            layers = <0>;
        };

        base_5 {
            bindings = <&kp NUMBER_5>;
            key-positions = <14 4>;
            layers = <0>;
        };

        base_6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <5 15>;
            layers = <0>;
        };

        base_7 {
            bindings = <&kp NUMBER_7>;
            key-positions = <6 16>;
            layers = <0>;
        };

        base_8 {
            bindings = <&kp NUMBER_8>;
            key-positions = <7 17>;
            layers = <0>;
        };

        base_9 {
            bindings = <&kp NUMBER_9>;
            key-positions = <18 8>;
            layers = <0>;
        };

        base_0 {
            bindings = <&kp NUMBER_0>;
            key-positions = <19 9>;
            layers = <0>;
        };

        base_copy {
            bindings = <&kp LC(C)>;
            key-positions = <10 11>;
            layers = <0>;
            require-prior-idle-ms = <100>;
            timeout-ms = <30>;
        };

        base_paste {
            bindings = <&kp LC(V)>;
            key-positions = <0 11>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        base_cut {
            bindings = <&kp LC(X)>;
            key-positions = <11 21>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        base_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;
            layers = <0>;
        };

        base_redo {
            bindings = <&kp LC(Y)>;
            key-positions = <22 24>;
            layers = <0>;
        };

        spreadsheet_del_col {
            bindings = <&spreadsheet_del_col>;
            key-positions = <15 26>;
            layers = <0>;
        };

        spreadsheet_del_row {
            bindings = <&spreadsheet_del_row>;
            key-positions = <26 27>;
            layers = <0>;
        };

        spreadsheet_ins_col {
            bindings = <&spreadsheet_ins_col>;
            key-positions = <16 27>;
            layers = <0>;
        };

        spreadsheet_ins_row {
            bindings = <&spreadsheet_ins_row>;
            key-positions = <27 28>;
            layers = <0>;
        };

        spreadsheet_hide_col {
            bindings = <&kp LC(NUMBER_0)>;
            key-positions = <17 28>;
            layers = <0>;
        };

        spreadsheet_hide_row {
            bindings = <&kp LC(N9)>;
            key-positions = <28 29>;
            layers = <0>;
        };

        base_hyphen {
            bindings = <&kp MINUS>;
            key-positions = <8 9>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };

        cpy_cell_to_abv_next: copy_cell_to_above_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(C) &kp UP_ARROW &kp LC(V) &kp RIGHT &kp DOWN>;

            label = "COPY_CELL_TO_ABOVE_NEXT";
        };

        parenth_block: auto_parenth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;

            label = "AUTO_PARENTH";
        };

        bracket_block: bracket_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;

            label = "BRACKET_BLOCK";
        };

        brace_block: brace_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;

            label = "BRACE_BLOCK";
        };

        spreadsheet_del_col: spreadsheet_del_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp SPACE &kp MINUS>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "SPREADSHEET_DEL_COL";
        };

        spreadsheet_del_row: spreadsheet_del_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp SPACE &kp MINUS>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SPREADSHEET_DEL_ROW";
        };

        spreadsheet_ins_col: spreadsheet_ins_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp SPACE &kp PLUS>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "SPREADSHEET_INS_COL";
        };

        spreadsheet_ins_row: spreadsheet_ins_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp SPACE &kp PLUS>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SPREADSHEET_INS_ROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                      &kp Q  &kp W       &kp F             &kp P        &kp G              &kp J        &kp L        &kp U         &kp Y       &kp SEMICOLON
                      &kp A  &mt LALT R  &mt LEFT_SHIFT S  &mt LCTRL T  &kp D              &kp H        &mt RCTRL N  &mt RSHIFT E  &mt RALT I  &kp O
&mt LEFT_SHIFT GRAVE  &kp Z  &kp X       &kp C             &kp V        &kp B              &kp K        &kp M        &kp COMMA     &kp DOT     &kp SLASH      &mt RSHIFT APOSTROPHE
                                         &kp LEFT_GUI      &kp DELETE   &lt 1 BACKSPACE    &lt 2 SPACE  &kp RETURN   &kp LEFT_ALT
            >;
        };

        num_layer {
            bindings = <
         &kp F1     &kp F2     &kp F3    &kp F4   &kp LEFT_BRACE          &kp RIGHT_BRACE        &kp F5   &kp F6        &kp F7   &kp F8
         &kp N6     &kp N4     &kp N0    &kp N2   &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp N3   &kp N1        &kp N5   &kp N7
&kp ESC  &kp EQUAL  &kp MINUS  &kp FSLH  &kp N8   &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp N9   &kp ASTERISK  &kp DOT  &kp PLUS  &kp BSLH
                               &kp F9    &kp F10  &trans                  &trans                 &kp F11  &kp F12
            >;
        };

        adjust_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "ADJ";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃           ┃  STUDIO   ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃           ┃           ┃           ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃           ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &sys_reset    &bootloader   &out OUT_TOG   &bt BT_CLR     &studio_unlock           &trans    &trans    &trans  &trans     &trans
              &trans        &kp PAGE_UP   &caps_word     &kp PAGE_DOWN  &cpy_cell_to_abv_next    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_CLR_ALL           &trans    &trans    &trans  &trans     &trans  &trans
                                          &kp LEFT_META  &kp LEFT_ALT   &kp LEFT_CONTROL         &trans    &trans    &trans
            >;
        };

        game_layer {
            bindings = <
         &kp TAB    &kp Q  &kp W     &kp E    &kp R        &kp N1  &kp N2  &kp N3    &kp N4  &kp N5
         &kp LSHFT  &kp A  &kp S     &kp D    &kp F        &kp N6  &kp N7  &kp N8    &kp N9  &kp N0
&kp ESC  &kp LCTRL  &kp Z  &kp X     &kp C    &kp V        &kp F1  &kp F2  &kp F3    &kp F4  &kp F5  &kp F6
                           &kp LALT  &mt J I  &kp SPACE    &kp M   &kp L   &kp RALT
            >;
        };
    };
};
